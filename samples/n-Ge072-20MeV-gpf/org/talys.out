 #
 # Basic physical and numerical parameters
 #
 ejectiles g n p d t h a   outtype      outgoing particles
 maxz               12     maxZ         maximal number of protons from the initial compound nucleus
 maxn               32     maxN         maximal number of neutrons from the initial compound nucleus
