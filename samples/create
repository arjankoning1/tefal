#!/usr/bin/env bash
# Refresh TEFAL reference results in org/ and prepare user new/ inputs.
set -u
set -o pipefail

samples_dir=$(cd "$(dirname "$0")" && pwd)
cd "$samples_dir"
tefal="$samples_dir/../bin/tefal"
talys="${TALYS_DIR:+$TALYS_DIR/bin/talys}"
talys=${talys:-"$samples_dir/../../talys/bin/talys"}
dry_run=0

usage() {
  echo "Usage:"
  echo "  ./create_new --dry-run"
  echo "  ./create_new [--tefal /path/to/tefal] [--talys /path/to/talys]"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -e|--tefal) [[ $# -ge 2 ]] || { echo "*** TEFAL create error: $1 requires a pathname" >&2; exit 2; }; tefal=$2; shift 2 ;;
    -t|--talys) [[ $# -ge 2 ]] || { echo "*** TEFAL create error: $1 requires a pathname" >&2; exit 2; }; talys=$2; shift 2 ;;
    -n|--dry-run) dry_run=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "*** TEFAL create error: unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
done

resolve_executable() {
  local path=$1 directory
  if [[ "$path" != /* ]]; then
    directory=$(cd "$(dirname "$path")" 2>/dev/null && pwd) || return 1
    path="$directory/$(basename "$path")"
  fi
  [[ -x "$path" ]] || return 1
  printf '%s\n' "$path"
}

tefal=$(resolve_executable "$tefal") || { echo "*** TEFAL create error: TEFAL executable not found" >&2; exit 2; }
talys=$(resolve_executable "$talys") || { echo "*** TEFAL create error: TALYS executable not found" >&2; exit 2; }
talys_dir=$(cd "$(dirname "$talys")/.." && pwd)
if [[ ! -d "$talys_dir/structure" ]]; then
  local_talys_dir=$(cd "$samples_dir/../../talys" 2>/dev/null && pwd) || local_talys_dir=
  if [[ -n "$local_talys_dir" && -d "$local_talys_dir/structure" ]]; then
    echo "Using structure database from $local_talys_dir (the selected TALYS executable is outside a TALYS installation)." >&2
    talys_dir=$local_talys_dir
  else
    echo "*** TEFAL create error: TALYS structure directory not found: $talys_dir/structure" >&2
    exit 2
  fi
fi

cases=()
while IFS= read -r input; do cases+=("$input"); done < <(find . -type f -path '*/org/tefal.inp' -print | LC_ALL=C sort)
nfiles=${#cases[@]}
[[ "$nfiles" -gt 0 ]] || { echo "*** TEFAL create error: no sample cases found" >&2; exit 2; }

interrupted() { echo "*** TEFAL sample creation interrupted; stopping after the current command." >&2; exit "$1"; }
trap 'interrupted 130' INT
trap 'interrupted 143' TERM HUP

echo
echo "TEFAL reference-sample creation"
echo "TEFAL executable: $tefal"
echo "TALYS executable: $talys"
echo "TALYS_DIR:        $talys_dir"
echo "Sample cases:     $nfiles"
echo "Mode:             $([[ "$dry_run" -eq 1 ]] && echo dry-run || echo refresh-org)"
echo

if [[ "$dry_run" -eq 1 ]]; then
  for input in "${cases[@]}"; do org_dir=$(dirname "$input"); echo "would run ${org_dir#./} and recreate ${org_dir%/org}/new"; done
  exit 0
fi

: > times_create.log
start=$(date '+%F,%T'); host=$(uname -n); total_start=$(date +%s)
printf 'TEFAL create started on %s at %s\nTEFAL executable: %s\nTALYS executable: %s\nTALYS_DIR: %s\nSample cases: %s\n\n' "$host" "$start" "$tefal" "$talys" "$talys_dir" "$nfiles" >> times_create.log
failures=0; ii=0

for input in "${cases[@]}"; do
  ii=$((ii + 1)); org_dir=$(dirname "$input"); case_dir=$(dirname "$org_dir"); new_dir="$case_dir/new"; case_name=${case_dir#./}
  echo "$ii/$nfiles  *** Sample case $case_name"
  if ! rm -rf "$new_dir" || ! mkdir -p "$new_dir"; then echo "*** Unable to recreate $new_dir" >&2; failures=$((failures + 1)); continue; fi
  shopt -s nullglob
  input_files=("$org_dir"/tefal*.inp "$org_dir"/energies "$org_dir"/talys.inp "$org_dir"/*.omp "$org_dir"/*.mf2 "$org_dir"/*endfb* "$org_dir"/*jendl* "$org_dir"/*jeff*)
  shopt -u nullglob
  copy_failed=0
  for file in "${input_files[@]}"; do [[ -f "$file" ]] && ! cp "$file" "$new_dir/" && copy_failed=1; done
  if [[ "$copy_failed" -ne 0 ]]; then echo "*** Unable to copy inputs for $case_name" >&2; failures=$((failures + 1)); continue; fi
  t0=$(date +%s); err=0
  echo "          Running TALYS"
  (cd "$org_dir" && TALYS_DIR="$talys_dir" "$talys" < talys.inp > talys.out) || err=$?
  if [[ "$err" -eq 0 ]]; then
    echo "          Running TEFAL"
    (cd "$org_dir" && "$tefal" < tefal.inp > tefal.out && colrm 81 < tefal.out > tefal.out80) || err=$?
  fi
  if [[ "$err" -eq 0 && -f "$org_dir/tefal2.inp" ]]; then (cd "$org_dir" && "$tefal" < tefal2.inp > tefal2.out) || err=$?; fi
  [[ "$err" -eq 0 ]] || { echo "*** TEFAL creation failed for $case_name: exit status $err" >&2; failures=$((failures + 1)); }
  t1=$(date +%s); dt=$((t1-t0)); elapsed=$((t1-total_start))
  printf '%3d/%-3d %-35s %s  time:%6d s  total:%6d s  err:%d\n' "$ii" "$nfiles" "$case_name" "$(date '+%F,%T')" "$dt" "$elapsed" "$err" >> times_create.log
  echo "          time: $dt s"
done

elapsed=$(($(date +%s)-total_start)); echo "------------------------------------------------------------"; echo "TEFAL sample creation completed"; echo "Cases run: $ii"; echo "Execution errors: $failures"; echo "Elapsed time: $elapsed s"
printf '\nFinished: %s\nElapsed time: %s s\nExecution errors: %s\n' "$(date '+%F,%T')" "$elapsed" "$failures" >> times_create.log
[[ "$failures" -eq 0 ]]
